    {
        "id": "ae5148e0a9f19592",
        "type": "function",
        "z": "d73189f7bef27609",
        "name": "Parse",
        "func": "let text = msg.payload.content;\n\nlet message = text.split(\" \")\nlet type = message[0] || \"\"\nlet city = message[1] || \"\"\nlet country = message[2] || \"\"\n\nmsg.query = { type: type, city: city, country: country }\n\nif (type === \"QUERY\" || type === \"REPORT\")\n    return [msg, null, null]\nelse if (type === \"TRACK\")\n    return [null, msg, null]\nelse\n    return [null, null, msg]\n",
        "outputs": 3,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
