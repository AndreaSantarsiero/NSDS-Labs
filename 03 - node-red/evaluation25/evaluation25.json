    {
        "id": "264b274fd4a8e5e0",
        "type": "function",
        "z": "d73189f7bef27609",
        "name": "TRACK answer",
        "func": "let q = msg.query\nlet city = { city: q.city, country: q.country }\n\nlet key = String(msg.originalMessage.from.id)\nlet cities = flow.get(key) || []\nif (!cities.some(c => c.city === city.city && c.country === city.country)) {\n    cities.push(city);\n}\nflow.set(key, cities)\n\nlet answer = \"Tracking temperature for \" + q.city + \"!\"\nmsg.payload = { text: answer };\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
