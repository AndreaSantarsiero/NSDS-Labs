    {
        "id": "cf4e28d72cd71080",
        "type": "function",
        "z": "a13034e0970d9f68",
        "name": "Compute average",
        "func": "let temperatures = context.get(\"temp\") || [];\n\nif (msg.payload.fields.temperature != undefined) {\n    temperatures.push(msg.payload.fields.temperature);\n\n    if (temperatures.length > 10) {\n        temperatures.shift();\n    }\n\n    let sum = temperatures.reduce((acc, temp) => acc + temp, 0);\n    let avg = sum / temperatures.length;\n\n    context.set(\"temp\", temperatures);\n\n    msg.payload.averageTemperature = avg;\n    flow.set(\"average\", avg);\n    return msg;\n}\nelse {\n    return null;\n}",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
