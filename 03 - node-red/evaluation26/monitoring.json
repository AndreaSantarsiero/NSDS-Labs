    {
        "id": "c5f857e7262a8cc9",
        "type": "function",
        "z": "1d1684a7eede910b",
        "name": "Resetter",
        "func": "let topic = msg.topic || null\nlet message = \"\"\n\nif (topic == \"A\"){\n    flow.set(\"counterA\", 0)\n    flow.set(\"latestA\", undefined)\n    message = \"Succesfully reset room A\"\n}\nelse if (topic == \"B\") {\n    flow.set(\"counterB\", 0)\n    flow.set(\"latestB\", undefined)\n    message = \"Succesfully reset room B\"\n}\nelse{\n    flow.set(\"counterA\", 0)\n    flow.set(\"counterB\", 0)\n    flow.set(\"latestA\", undefined)\n    flow.set(\"latestB\", undefined)\n    flow.set(\"alertCounter\", 0)\n    message = \"Succesfully reset room A and B\"\n}\n\nmsg.payload = message\nreturn msg",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "// Code added here will be run once\n// whenever the node is started.\nflow.set(\"counterA\", 0)\nflow.set(\"counterB\", 0)\nflow.set(\"latestA\", undefined)\nflow.set(\"latestB\", undefined)\nflow.set(\"alertCounter\", 0)\n",
        "finalize": "",
        "libs": [],
        "x": 380,
        "y": 180,
        "wires": [
            [
                "2b838520d1cb30bc"
            ]
        ]
    },
