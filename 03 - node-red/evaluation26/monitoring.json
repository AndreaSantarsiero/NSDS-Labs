    {
        "id": "6c95ce7241f53c5e",
        "type": "function",
        "z": "1d1684a7eede910b",
        "name": "Parser",
        "func": "let topic = msg.topic || null\nlet current = msg.payload\nlet threshold = global.get(\"threshold\")\n\nif (!(topic == \"A\" || topic == \"B\")){\n    msg.payload = \"Unknown room \" + topic\n    return msg\n}\n\nflow.set(\"latest\" + topic, current)\n\nif(current > threshold){\n    let counter = flow.get(\"counter\" + topic) || 0\n    if(counter == 1){\n        let alert = {\n            room: topic, reading: current, limit: threshold\n        }\n        msg.alert = alert\n    }\n    flow.set(\"counter\" + topic, (counter + 1))\n}\nelse{\n    flow.set(\"counter\" + topic, 0)\n}\n\n\nreturn msg",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 470,
        "y": 660,
        "wires": [
            [
                "acba10f28b7ac7b3"
            ]
        ]
    },
