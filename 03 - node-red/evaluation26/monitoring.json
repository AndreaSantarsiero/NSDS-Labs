    {
        "id": "479c65904dc7d4eb",
        "type": "function",
        "z": "1d1684a7eede910b",
        "name": "Print report",
        "func": "let message = \"\"\n\nlet roomA = msg.payload.roomA != undefined \n    ? msg.payload.roomA\n    : \"unknown\"\nlet roomB = msg.payload.roomB != undefined\n    ? msg.payload.roomB\n    : \"unknown\"\n\nmessage += \"REPORT A=\" + roomA\nmessage += \" B=\" + roomB\nmessage += \" limit=\" + msg.payload.limit\nmessage += \" alerts=\" + msg.payload.alerts\n\nmsg.payload = message\nreturn msg;",
