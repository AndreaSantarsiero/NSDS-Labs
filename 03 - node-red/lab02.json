            ]
        ]
    },
    {
        "id": "be7ea94872eb0e88",
        "type": "function",
        "z": "0f878789f06582b5",
        "name": "Greetings answer",
        "func": "let name = msg.payload.content\nlet names = flow.get(\"names\") || []\n\nname = name.slice(11)\nname = name.replace(/[!,.;:]/g, '')\n\nif(!names.includes(name)){\n    names.push(name)\n    flow.set(\"names\", names);\n}\n\nlet message = \"Hello \" + name + \"!\"\n\nmsg.payload.content = message\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "// Code added here will be run once\n// whenever the node is started.\nflow.set(\"names\", []);",
        "finalize": "",
        "libs": [],
