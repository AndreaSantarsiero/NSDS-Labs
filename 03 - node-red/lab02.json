    {
        "id": "bd0c58a43bee69c5",
        "type": "function",
        "z": "0f878789f06582b5",
        "name": "Generic answer",
        "func": "if (msg.payload.content == \"What's your name?\") {\n    msg.payload.content = \"[Andrea] I am the NSDS Telegram Bot!\";\n}\nelse if (msg.payload.content == \"Ciao\") {\n    msg.payload.content = \"[Andrea] Ciao!\";\n}\nelse {\n    msg.payload.content = \"[Andrea] I don't get what you're asking...\";\n}\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 560,
        "y": 380,
