    {
        "id": "dec3cd8c10ad9a5a",
        "type": "function",
        "z": "f6f2187d.f17ca8",
        "name": "Humidity Processing",
        "func": "let lastHumidity = context.get(\"lastHumidity\")\nlet humidity = msg.payload.humidity\n\n\nif (humidity > lastHumidity)\n    msg.payload.humidityFeedback = \"high\"\nelse if (humidity < lastHumidity)\n    msg.payload.humidityFeedback = \"low\"\nelse\n    msg.payload.humidityFeedback = \"equal\"\n\n\ncontext.set(\"lastHumidity\", humidity)\nreturn msg;",
        "outputs": 1,
