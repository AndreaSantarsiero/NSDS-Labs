    {
        "id": "8defcd169b50bd8f",
        "type": "function",
        "z": "f6f2187d.f17ca8",
        "name": "Tempc Processing",
        "func": "let lastTemperature = context.get(\"lastTemperature\")\nlet tempc = msg.payload.tempc\n\n\nif (tempc > lastTemperature)\n    msg.payload.tempcFeedback = \"high\"\nelse if (tempc < lastTemperature)\n    msg.payload.tempcFeedback = \"low\"\nelse\n    msg.payload.tempcFeedback = \"equal\"\n\n\ncontext.set(\"lastTemperature\", tempc)\nreturn msg;",
        "outputs": 1,
