    {
        "id": "03cceef87f30e280",
        "type": "function",
        "z": "d73189f7bef27609",
        "name": "Log Counters",
        "func": "let f = flow.get(\"count_forecast\") || 0;\nlet w = flow.get(\"count_wind\") || 0;\n\n// reset to zero\nflow.set(\"count_forecast\", 0);\nflow.set(\"count_wind\", 0);\n\nmsg.payload = new Date().toISOString() + \" forecast=\" + f + \" wind=\" + w;\nreturn msg;",
        "outputs": 1,
