    {
        "id": "ae5148e0a9f19592",
        "type": "function",
        "z": "d73189f7bef27609",
        "name": "Parse",
        "func": "let text = msg.payload.content.toLowerCase();\n\n// City\nlet city = null;\nif (text.includes(\"milan\") || text.includes(\"milano\")) city = \"Milan\";                       // \"milan\" and \"milano\"\nelse if (text.includes(\"rome\") || text.includes(\"roma\")) city = \"Rome\";\n\n// Kind of request\nlet kind = null;\nif (text.includes(\"wind\")) kind = \"wind\";\nelse if (text.includes(\"forecast\") || text.includes(\"weather\")) kind = \"forecast\";\n\n// Days: check first \"2 days\", since \"day after tomorrow\" contains \"tomorros\"\nlet days = null;\nif (/two days|2 days|day after tomorrow/.test(text)) days = 2;\nelse if (/tomorrow|one day|1 day/.test(text)) days = 1;\n\nif (city === null || kind === null || days === null) {\n    return [null, null, msg];       // unhandled request\n}\n\nmsg.query = { city: city, kind: kind, days: days };\nreturn (city === \"Milan\") ? [msg, null, null] : [null, msg, null];",
        "outputs": 3,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 390,
        "y": 360,
        "wires": [
            [
                "b52944fe8009c828"
            ],
            [
                "e623b300920a2c86"
            ],
            [
                "88275ea622288c70"
            ]
        ]
    },
    {
        "id": "264b274fd4a8e5e0",
        "type": "function",
        "z": "d73189f7bef27609",
        "name": "Answer",
        "func": "let q = msg.query;\nlet entry = msg.payload[q.days * 8];    // +24h or +48h\n\nlet value = (q.kind === \"wind\")\n    ? entry.wind.speed\n    : entry.weather[0].description;\n\n// build the key for this message and check the previous answer\nlet key = q.kind + \"_\" + q.city + \"_\" + q.days;\nlet last = context.get(key);\nlet note;\nif (last === undefined) {\n    note = \"This is the first time I was asked!\";\n} else if (last === value) {\n    note = \"It is the same as the last time I was asked!\";\n} else {\n    note = \"It changed since the last time I was asked!\";\n}\ncontext.set(key, value);\n\n// count the served request\nlet counterKey = \"count_\" + q.kind;\nflow.set(counterKey, (flow.get(counterKey) || 0) + 1);\n\n// format answer\nlet when = (q.days === 1) ? \"tomorrow\" : \"in two days\";\nlet answer;\nif (q.kind === \"forecast\") {\n    answer = (q.days === 1) ? \"Tomorrow's forecast for \" + q.city\n        : \"The forecast for \" + q.city + \" in two days\";\n    answer += \" is \" + value + \"! \" + note;\n} else {\n    answer = \"Expected wind speed in \" + q.city + \" \" + when + \" is \" + value + \" m/s! \" + note;\n}\n\nmsg.payload = { text: answer };\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 840,
        "y": 320,
        "wires": [
